---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { getNews, getGuides } from '../lib/content';
import { ROLES, roleSlug } from '../config/roles';
import { fetchWeather } from '../lib/weather';

const allNews = await getNews();
const news = allNews.slice(0, 6);
const guides = (await getGuides()).slice(0, 3);
const todayCount = allNews.filter((n) => n.data.date === allNews[0].data.date).length;

const wx = await fetchWeather();
const cities = Object.keys(wx);
---
<Base>
  <div class="wrap">
    <script is:inline>
      // 하루 첫 방문에만, 움직임 줄이기 설정이 꺼져 있을 때만 재생한다.
      try {
        const day = new Date().toDateString();
        if ((localStorage.getItem('intro') !== day || location.search.includes('intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          localStorage.setItem('intro', day);
          document.documentElement.classList.add('intro');
        }
      } catch {}
    </script>
    <section class="hero hud">
      <div class="hud-log">
        <p class="hud-line" style="--i:1"><span>오늘 브리핑 준비</span><b>완료</b></p>
        {cities.length > 0
          ? <div id="cityrow" data-wx={JSON.stringify(wx)}>
              <p class="hud-line" style="--i:5"><span><span id="cityname">날씨</span> <button type="button" id="citychange" hidden>바꾸기</button></span><b id="wx" aria-live="polite">지역을 골라 주세요</b></p>
              <p class="hud-line" id="tiprow" hidden><span>오늘 챙길 것</span><b id="tip" aria-live="polite"></b></p>
              <div class="hud-chips" id="chips" role="group" aria-label="날씨를 볼 지역 고르기" style="--i:7">{cities.map((c) => <button type="button" data-city={c}>{c}</button>)}</div>
            </div>
          : <p class="hud-line" style="--i:5"><span>날씨</span><b>확인하지 못함</b></p>}
        <p class="hud-line" style="--i:9"><span>오늘 AI 소식</span><b>{todayCount}건 정리</b></p>
        <p class="hud-line" style="--i:13"><span>화면 모드</span><b id="mode">자동</b></p>
        <h1 id="hi">안녕하세요.</h1>
        <p class="hud-say">브리핑을 시작합니다. 아래에서 내 일에 맞는 소식을 골라 보세요.</p>
      </div>
      <div class="hud-dial">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <g class="ring-ticks"><line x1="100" y1="6" x2="100" y2="14" transform="rotate(0 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(6 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(12 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(18 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(24 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(30 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(36 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(42 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(48 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(54 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(60 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(66 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(72 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(78 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(84 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(90 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(96 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(102 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(108 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(114 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(120 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(126 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(132 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(138 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(144 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(150 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(156 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(162 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(168 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(174 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(180 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(186 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(192 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(198 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(204 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(210 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(216 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(222 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(228 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(234 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(240 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(246 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(252 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(258 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(264 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(270 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(276 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(282 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(288 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(294 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(300 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(306 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(312 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(318 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(324 100 100)" /><line x1="100" y1="6" x2="100" y2="14" transform="rotate(330 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(336 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(342 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(348 100 100)" /><line x1="100" y1="6" x2="100" y2="10" transform="rotate(354 100 100)" /></g>
          <circle class="ring-a" cx="100" cy="100" r="82" pathLength="100" />
          <circle class="ring-b" cx="100" cy="100" r="70" pathLength="100" />
          <circle class="ring-c" cx="100" cy="100" r="58" />
        </svg>
        <p class="hud-time"><span id="clock">--:--</span><span id="date"></span></p>
      </div>
    </section>

    <section class="sec build" aria-labelledby="h-role">
      <div class="sec-head"><h2 id="h-role">내 일에 맞게 보기</h2></div>
      <ul class="roles">
        {ROLES.map((r) => <li><a href={`/role/${roleSlug(r)}/`}>{r}</a></li>)}
      </ul>
    </section>

    {guides.length > 0 && (
      <section class="sec build" aria-labelledby="h-guide">
        <div class="sec-head"><h2 id="h-guide">따라하기 가이드</h2><a class="more" href="/guides/">전체 보기 →</a></div>
        <div class="grid">{guides.map((g) => <GuideCard entry={g} />)}</div>
      </section>
    )}

    <section class="sec build" aria-labelledby="h-news">
      <div class="sec-head"><h2 id="h-news">오늘의 AI 소식</h2><a class="more" href="/news/">전체 보기 →</a></div>
      {news.length > 0
        ? <div class="grid">{news.map((n) => <NewsCard entry={n} showDate compact />)}</div>
        : <p class="none">아직 올라온 소식이 없습니다.</p>}
    </section>
  </div>
  <script is:inline>
    (() => {
      const h = new Date().getHours();
      const hi = h < 5 ? '늦은 시간까지 수고 많으십니다.' : h < 11 ? '좋은 아침입니다.' : h < 18 ? '좋은 오후입니다.' : '좋은 저녁입니다.';
      const el = document.getElementById('hi'), clock = document.getElementById('clock'), date = document.getElementById('date');
      const tick = () => {
        const d = new Date();
        clock.textContent = d.toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', hour12: false });
        date.textContent = d.toLocaleDateString('ko-KR', { month: 'long', day: 'numeric', weekday: 'short' });
      };
      tick(); setInterval(tick, 15000);
      document.getElementById('mode').textContent = h >= 6 && h < 18 ? '주간 (밝게)' : '야간 (어둡게)';
      // 고른 지역은 이 브라우저에만 기억한다. 날씨 값은 페이지에 이미 들어 있어 따로 요청하지 않는다.
      const row = document.getElementById('cityrow');
      if (row) {
        const map = JSON.parse(row.dataset.wx), chips = document.getElementById('chips'), change = document.getElementById('citychange');
        const pick = (c) => {
          document.getElementById('cityname').textContent = c + ' 날씨';
          document.getElementById('wx').textContent = map[c].sky;
          document.getElementById('tip').textContent = map[c].tip; document.getElementById('tiprow').hidden = false;
          chips.hidden = true; change.hidden = false;
        };
        try { const saved = localStorage.getItem('city'); if (saved in map) pick(saved); } catch {}
        chips.addEventListener('click', (e) => {
          const c = e.target.dataset.city; if (!c) return;
          pick(c); change.focus();
          try { localStorage.setItem('city', c); } catch {}
        });
        change.addEventListener('click', () => { chips.hidden = false; change.hidden = true; chips.querySelector('button').focus(); });
      }
      const root = document.documentElement;
      if (!root.classList.contains('intro')) { el.textContent = hi; return; }
      // 상태 보고가 끝난 뒤 인사를 한 글자씩 쓰고, 누르거나 스크롤하면 바로 완성한다.
      let i = 0, t; el.textContent = ''; el.setAttribute('aria-label', hi);
      const start = setTimeout(() => { t = setInterval(() => { el.textContent = hi.slice(0, ++i); if (i >= hi.length) clearInterval(t); }, 45); }, 1300);
      const done = () => { clearTimeout(start); clearInterval(t); el.textContent = hi; root.classList.add('intro-done'); };
      for (const e of ['pointerdown', 'keydown', 'wheel', 'touchstart']) addEventListener(e, done, { once: true, passive: true });
    })();
  </script>
</Base>
